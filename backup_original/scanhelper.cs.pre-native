        Button bDeletePreset = new Button { Text = "🗑", Location = new Point(299, 9), Size = new Size(30, 26), BackColor = Color.White, FlatStyle = FlatStyle.Flat, Cursor = Cursors.Hand, Font = new Font("Segoe UI", 8.5f) };
