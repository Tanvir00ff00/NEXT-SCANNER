        SegmentedControl segBedSelection = new SegmentedControl();
        segBedSelection.Location = new Point(515, 50);
        segBedSelection.Size = new Size(145, 28);
        tt.SetToolTip(segBedSelection, "Switch between Full Bed view and Selected Document view");

        ModernCardPanel pCanvasFrame = new ModernCardPanel();
        pCanvasFrame.Location = new Point(16, 82);
        pCanvasFrame.Size = new Size(PW, PH);

        PictureBox picPreview = new PictureBox();
        picPreview.Dock = DockStyle.Fill;
        picPreview.SizeMode = PictureBoxSizeMode.Zoom;
        picPreview.BackColor = Color.White;
        picPreview.Cursor = Cursors.Cross;
        pCanvasFrame.Controls.Add(picPreview);

        Bitmap rawPreviewImg = null;
        Bitmap filteredPreviewImg = null;
        bool isPreviewRunning = false;
        float scanProgress = 0f;
        DateTime scanStartTime = DateTime.Now;
        System.Windows.Forms.Timer scanAnimTimer = new System.Windows.Forms.Timer();
        scanAnimTimer.Interval = 30; // ~33 FPS

        bool isDrawMode = false;
        DragHandle activeDrag = DragHandle.None;
        Point dragStartMouse = Point.Empty;
        RectangleF dragStartCrop = RectangleF.Empty;
        const int HANDLE_SIZE = 8;

        // Current filter parameters
        PreviewColorMode currentColorMode = PreviewColorMode.Color24;
        CustomColorPreset currentCustomPreset = null;
        Action updateSummary = delegate { };
        Button bPreviewScan = new Button();
        Button bScan = new Button();

        Action applyLiveFilters = delegate {
            if (rawPreviewImg == null) return;
            try {
                bool autoCol = S.ContainsKey("autocolor") ? (S["autocolor"] == "on") : true;
                bool autoStr = S.ContainsKey("deskew") && S["deskew"] == "on";
                float angle = currentRotatedBox.IsValid ? currentRotatedBox.Angle : 0f;

                Bitmap filtered = ApplyPreviewImageFilters(
                    rawPreviewImg,
                    currentColorMode,
                    currentCustomPreset,
                    autoCol,
                    autoStr,
                    angle
                );

                if (filtered != null) {
                    if (filteredPreviewImg != null) filteredPreviewImg.Dispose();
                    filteredPreviewImg = filtered;
                    picPreview.Image = filteredPreviewImg;
                }
            } catch { }
            picPreview.Invalidate();
        };

        scanAnimTimer.Tick += delegate {
            if (isPreviewRunning) {
                double elapsed = (DateTime.Now - scanStartTime).TotalSeconds;
                // Period = 2.4s for one full sweep from top to bottom (4.8s round-trip continuous loop)
                double cycle = (elapsed % 4.8) / 2.4;
                float pos = (cycle <= 1.0) ? (float)cycle : (float)(2.0 - cycle);
                // Cosine easing for fluid, high-tech scanner head motion
                scanProgress = (float)((1.0 - Math.Cos(pos * Math.PI)) / 2.0);
                picPreview.Invalidate();
            }
        };

        Action reloadCachedPreview = delegate {
            try {
                if (File.Exists(PREVIEW) && new FileInfo(PREVIEW).Length > 500) {
                    if (rawPreviewImg != null) rawPreviewImg.Dispose();
                    using (FileStream fs = new FileStream(PREVIEW, FileMode.Open, FileAccess.Read, FileShare.ReadWrite)) {
                        rawPreviewImg = new Bitmap(Image.FromStream(fs));
                    }
                    applyLiveFilters();
                }
            } catch { }
            picPreview.Invalidate();
        };
        reloadCachedPreview();

        Func<Rectangle> getCropScreenRect = delegate {
            Rectangle disp = GetImageDisplayRect(picPreview);
            int cx = disp.X + (int)(disp.Width * currentCropNorm.X);
            int cy = disp.Y + (int)(disp.Height * currentCropNorm.Y);
            int cw = (int)(disp.Width * currentCropNorm.Width);
            int ch = (int)(disp.Height * currentCropNorm.Height);
            return new Rectangle(cx, cy, cw, ch);
        };

        // Draw In-Canvas Floating Badges + Crop Marquee + Live Scanner Laser Carriage Animation
        picPreview.Paint += delegate(object sender, PaintEventArgs e) {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;

            Rectangle disp = GetImageDisplayRect(picPreview);

            // ================= LIVE CONTINUOUS SCANNER LASER CARRIAGE ANIMATION =================
            if (isPreviewRunning)
            {
                int beamY = disp.Y + (int)(disp.Height * scanProgress);

                // 1. Scanned Region (illuminated grid overlay)
                using (SolidBrush scanRegion = new SolidBrush(Color.FromArgb(45, 0, 195, 255))) {
                    g.FillRectangle(scanRegion, disp.X, disp.Y, disp.Width, Math.Max(0, beamY - disp.Y));
                }

                // 2. Unscanned Region (flatbed dark glass)
                using (SolidBrush darkGlass = new SolidBrush(Color.FromArgb(170, 20, 24, 32))) {
                    g.FillRectangle(darkGlass, disp.X, beamY, disp.Width, Math.Max(0, disp.Bottom - beamY));
                }

                // 3. Laser Carriage Glow Bar
                int glowH = 28;
                Rectangle glowRect = new Rectangle(disp.X, Math.Max(disp.Y, beamY - glowH / 2), disp.Width, glowH);
                if (glowRect.Height > 0) {
                    using (LinearGradientBrush lgb = new LinearGradientBrush(glowRect, Color.FromArgb(0, 0, 195, 255), Color.FromArgb(220, 0, 225, 255), LinearGradientMode.Vertical)) {
                        g.FillRectangle(lgb, glowRect);
                    }
                }

                // 4. Razor Sharp Laser Core Beam Line
                using (Pen laserCore = new Pen(Color.White, 2.5f))
                using (Pen laserAura = new Pen(Color.FromArgb(230, 0, 220, 255), 4.5f)) {
                    g.DrawLine(laserAura, disp.X, beamY, disp.Right, beamY);
                    g.DrawLine(laserCore, disp.X, beamY, disp.Right, beamY);
                }

                // 5. High-Tech Floating Scanner HUD Capsule
                double elapsedSec = (DateTime.Now - scanStartTime).TotalSeconds;
                string sweepDir = ((elapsedSec % 4.8) <= 2.4) ? "\uD83D\uDDA8\uFE0F Scanning Flatbed..." : "\u21BB Optical Acquisition...";
                Rectangle hudRect = new Rectangle(disp.X + (disp.Width - 250) / 2, disp.Y + 20, 250, 32);
                using (GraphicsPath hp = new GraphicsPath()) {
                    hp.AddArc(hudRect.X, hudRect.Y, 12, 12, 180, 90);
                    hp.AddArc(hudRect.Right - 12, hudRect.Y, 12, 12, 270, 90);
                    hp.AddArc(hudRect.Right - 12, hudRect.Bottom - 12, 12, 12, 0, 90);
                    hp.AddArc(hudRect.X, hudRect.Bottom - 12, 12, 12, 90, 90);
                    hp.CloseFigure();

                    using (SolidBrush hudBg = new SolidBrush(Color.FromArgb(230, 15, 23, 42)))
                    using (Pen hudBorder = new Pen(Color.FromArgb(0, 195, 255), 1.5f)) {
                        g.FillPath(hudBg, hp);
                        g.DrawPath(hudBorder, hp);
                    }
                }
                using (Font hudFont = new Font("Segoe UI", 9.5f, FontStyle.Bold))
                using (Brush hudText = new SolidBrush(Color.White))
                using (StringFormat sfHud = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center }) {
                    g.DrawString(sweepDir, hudFont, hudText, hudRect, sfHud);
                }
                return;
            }

            if (picPreview.Image == null)
            {
                string msg = "\uD83D\uDD0D Place your document on the scanner\r\n\r\nClick [ \u21BB Preview scan ] below to start";
                using (Font fnt = new Font("Segoe UI", 11f, FontStyle.Regular))
                using (StringFormat sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center })
                using (Brush br = new SolidBrush(Color.FromArgb(120, 130, 145)))
                {
                    g.DrawString(msg, fnt, br, picPreview.ClientRectangle, sf);
                }
                return;
            }

            Rectangle cr = getCropScreenRect();

            // 1. Soft Dimmed Outer Area
            using (Brush dimBrush = new SolidBrush(Color.FromArgb(100, 0, 0, 0)))
            {
                g.FillRectangle(dimBrush, disp.X, disp.Y, disp.Width, Math.Max(0, cr.Y - disp.Y));
                g.FillRectangle(dimBrush, disp.X, cr.Bottom, disp.Width, Math.Max(0, disp.Bottom - cr.Bottom));
                g.FillRectangle(dimBrush, disp.X, cr.Y, Math.Max(0, cr.X - disp.X), cr.Height);
                g.FillRectangle(dimBrush, cr.Right, cr.Y, Math.Max(0, disp.Right - cr.Right), cr.Height);
            }

            // 2. Crisp Blue Marquee Border (#1473E6)
            using (Pen borderPen = new Pen(Color.FromArgb(20, 115, 230), 2f))
            {
                g.DrawRectangle(borderPen, cr);
            }

            // 3. 8 Solid Square Corner & Edge Handles
            Point[] handlePts = {
                new Point(cr.X, cr.Y),
                new Point(cr.X + cr.Width / 2, cr.Y),
                new Point(cr.Right, cr.Y),
                new Point(cr.Right, cr.Y + cr.Height / 2),
                new Point(cr.Right, cr.Bottom),
                new Point(cr.X + cr.Width / 2, cr.Bottom),
                new Point(cr.X, cr.Bottom),
                new Point(cr.X, cr.Y + cr.Height / 2)
            };

            using (Brush hBr = new SolidBrush(Color.FromArgb(20, 115, 230)))
            using (Pen hPen = new Pen(Color.White, 1.5f))
            {
                foreach (Point pt in handlePts)
                {
                    Rectangle hr = new Rectangle(pt.X - HANDLE_SIZE / 2, pt.Y - HANDLE_SIZE / 2, HANDLE_SIZE, HANDLE_SIZE);
                    g.FillRectangle(hBr, hr);
                    g.DrawRectangle(hPen, hr);
                }
            }

            // 4. In-Canvas Floating Badge (Top-Left: "Document detected" or "Custom selection")
            string statusPill = (currentRotatedBox.IsValid) ? "Document detected (AI)" : (isDrawMode ? "Draw selection mode" : "1 item selected");
            Rectangle badge1 = new Rectangle(disp.X + 14, disp.Y + 14, 136, 26);
            using (GraphicsPath bp = new GraphicsPath())
            {
                bp.AddArc(badge1.X, badge1.Y, 10, 10, 180, 90);
                bp.AddArc(badge1.Right - 10, badge1.Y, 10, 10, 270, 90);
                bp.AddArc(badge1.Right - 10, badge1.Bottom - 10, 10, 10, 0, 90);
                bp.AddArc(badge1.X, badge1.Bottom - 10, 10, 10, 90, 90);
                bp.CloseFigure();

                using (SolidBrush bb = new SolidBrush(Color.FromArgb(245, 255, 255, 255)))
                using (Pen bPen = new Pen(Color.FromArgb(215, 215, 215), 1f))
                {
                    g.FillPath(bb, bp);
                    g.DrawPath(bPen, bp);
                }
            }
            using (Font bFont = new Font("Segoe UI", 8.5f, FontStyle.Regular))
            using (Brush tb = new SolidBrush(Color.FromArgb(31, 31, 31)))
            using (StringFormat sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center })
            {
                g.DrawString(statusPill, bFont, tb, badge1, sf);
            }

            // 5. In-Canvas Floating Badge (Bottom-Left: "3.8 x 2.9 in · 1140 x 870 px")
            float inW = currentCropNorm.Width * 8.27f;
            float inH = currentCropNorm.Height * 11.69f;
            int dpiVal = 300;
            int.TryParse(S["dpi"], out dpiVal);
            int pxW = (int)Math.Round(inW * dpiVal);
            int pxH = (int)Math.Round(inH * dpiVal);
            string dimStr = inW.ToString("0.#") + " \u00D7 " + inH.ToString("0.#") + " in  \u00B7  " + pxW + " \u00D7 " + pxH + " px";
            Rectangle badge2 = new Rectangle(disp.X + 14, disp.Bottom - 40, 200, 26);
            using (GraphicsPath bp2 = new GraphicsPath())
            {
                bp2.AddArc(badge2.X, badge2.Y, 10, 10, 180, 90);
                bp2.AddArc(badge2.Right - 10, badge2.Y, 10, 10, 270, 90);
                bp2.AddArc(badge2.Right - 10, badge2.Bottom - 10, 10, 10, 0, 90);
                bp2.AddArc(badge2.X, badge2.Bottom - 10, 10, 10, 90, 90);
                bp2.CloseFigure();

                using (SolidBrush bb2 = new SolidBrush(Color.FromArgb(245, 255, 255, 255)))
                using (Pen bPen2 = new Pen(Color.FromArgb(215, 215, 215), 1f))
                {
                    g.FillPath(bb2, bp2);
                    g.DrawPath(bPen2, bp2);
                }
            }
            using (Font bFont2 = new Font("Segoe UI", 8.5f, FontStyle.Regular))
            using (Brush tb2 = new SolidBrush(Color.FromArgb(31, 31, 31)))
            using (StringFormat sf2 = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center })
            {
                g.DrawString(dimStr, bFont2, tb2, badge2, sf2);
            }
        };

        Func<Point, DragHandle> hitTestHandle = delegate(Point pt) {
            Rectangle cr = getCropScreenRect();
            int pad = HANDLE_SIZE + 4;

            if (Math.Abs(pt.X - cr.X) <= pad && Math.Abs(pt.Y - cr.Y) <= pad) return DragHandle.NW;
            if (Math.Abs(pt.X - cr.Right) <= pad && Math.Abs(pt.Y - cr.Y) <= pad) return DragHandle.NE;
            if (Math.Abs(pt.X - cr.Right) <= pad && Math.Abs(pt.Y - cr.Bottom) <= pad) return DragHandle.SE;
            if (Math.Abs(pt.X - cr.X) <= pad && Math.Abs(pt.Y - cr.Bottom) <= pad) return DragHandle.SW;

            if (Math.Abs(pt.Y - cr.Y) <= pad && pt.X >= cr.X && pt.X <= cr.Right) return DragHandle.N;
            if (Math.Abs(pt.Y - cr.Bottom) <= pad && pt.X >= cr.X && pt.X <= cr.Right) return DragHandle.S;
            if (Math.Abs(pt.X - cr.X) <= pad && pt.Y >= cr.Y && pt.Y <= cr.Bottom) return DragHandle.W;
            if (Math.Abs(pt.X - cr.Right) <= pad && pt.Y >= cr.Y && pt.Y <= cr.Bottom) return DragHandle.E;

            if (cr.Contains(pt)) return DragHandle.Body;
            return isDrawMode ? DragHandle.DrawNew : DragHandle.None;
        };

        picPreview.MouseDown += delegate(object sender, MouseEventArgs e) {
            if (picPreview.Image == null || e.Button != MouseButtons.Left) return;
            activeDrag = hitTestHandle(e.Location);
            dragStartMouse = e.Location;
            dragStartCrop = currentCropNorm;

            if (activeDrag == DragHandle.DrawNew) {
                Rectangle disp = GetImageDisplayRect(picPreview);
                float nx = Math.Max(0f, Math.Min(1f, (float)(e.X - disp.X) / disp.Width));
                float ny = Math.Max(0f, Math.Min(1f, (float)(e.Y - disp.Y) / disp.Height));
                currentCropNorm = new RectangleF(nx, ny, 0.01f, 0.01f);
                picPreview.Invalidate();
            }
        };

        picPreview.MouseMove += delegate(object sender, MouseEventArgs e) {
            if (picPreview.Image == null) return;
            Rectangle disp = GetImageDisplayRect(picPreview);

            if (activeDrag == DragHandle.None)
            {
                DragHandle h = hitTestHandle(e.Location);
                switch (h)
                {
                    case DragHandle.NW: case DragHandle.SE: picPreview.Cursor = Cursors.SizeNWSE; break;
                    case DragHandle.NE: case DragHandle.SW: picPreview.Cursor = Cursors.SizeNESW; break;
                    case DragHandle.N:  case DragHandle.S:  picPreview.Cursor = Cursors.SizeNS; break;
                    case DragHandle.E:  case DragHandle.W:  picPreview.Cursor = Cursors.SizeWE; break;
                    case DragHandle.Body: picPreview.Cursor = Cursors.SizeAll; break;
                    default: picPreview.Cursor = isDrawMode ? Cursors.Cross : Cursors.Default; break;
                }
            }
            else if (activeDrag == DragHandle.DrawNew)
            {
                float curX = Math.Max(0f, Math.Min(1f, (float)(e.X - disp.X) / disp.Width));
                float curY = Math.Max(0f, Math.Min(1f, (float)(e.Y - disp.Y) / disp.Height));
                float startX = Math.Max(0f, Math.Min(1f, (float)(dragStartMouse.X - disp.X) / disp.Width));
                float startY = Math.Max(0f, Math.Min(1f, (float)(dragStartMouse.Y - disp.Y) / disp.Height));

                float nx = Math.Min(startX, curX);
                float ny = Math.Min(startY, curY);
                float nw = Math.Max(0.04f, Math.Abs(curX - startX));
                float nh = Math.Max(0.04f, Math.Abs(curY - startY));

                if (Control.ModifierKeys.HasFlag(Keys.Shift)) {
                    float side = Math.Max(nw, nh);
                    nw = Math.Min(1f - nx, side);
                    nh = Math.Min(1f - ny, side);
                }

                currentCropNorm = new RectangleF(nx, ny, nw, nh);
                picPreview.Invalidate();
            }
            else
            {
                float dx = (float)(e.X - dragStartMouse.X) / disp.Width;
                float dy = (float)(e.Y - dragStartMouse.Y) / disp.Height;

                float nx = dragStartCrop.X;
                float ny = dragStartCrop.Y;
                float nw = dragStartCrop.Width;
                float nh = dragStartCrop.Height;

                switch (activeDrag)
                {
                    case DragHandle.Body:
                        nx = Math.Max(0f, Math.Min(1f - nw, dragStartCrop.X + dx));
                        ny = Math.Max(0f, Math.Min(1f - nh, dragStartCrop.Y + dy));
                        break;
                    case DragHandle.E:
                        nw = Math.Max(0.04f, Math.Min(1f - nx, dragStartCrop.Width + dx));
                        break;
                    case DragHandle.S:
                        nh = Math.Max(0.04f, Math.Min(1f - ny, dragStartCrop.Height + dy));
                        break;
                    case DragHandle.W:
                        float newW = dragStartCrop.Width - dx;
                        if (newW >= 0.04f && dragStartCrop.Right - newW >= 0f) { nx = dragStartCrop.Right - newW; nw = newW; }
                        break;
                    case DragHandle.N:
                        float newH = dragStartCrop.Height - dy;
                        if (newH >= 0.04f && dragStartCrop.Bottom - newH >= 0f) { ny = dragStartCrop.Bottom - newH; nh = newH; }
                        break;
                    case DragHandle.SE:
                        nw = Math.Max(0.04f, Math.Min(1f - nx, dragStartCrop.Width + dx));
                        nh = Math.Max(0.04f, Math.Min(1f - ny, dragStartCrop.Height + dy));
                        break;
                    case DragHandle.SW:
                        float newW_SW = dragStartCrop.Width - dx;
                        if (newW_SW >= 0.04f && dragStartCrop.Right - newW_SW >= 0f) { nx = dragStartCrop.Right - newW_SW; nw = newW_SW; }
                        nh = Math.Max(0.04f, Math.Min(1f - ny, dragStartCrop.Height + dy));
                        break;
                    case DragHandle.NE:
                        nw = Math.Max(0.04f, Math.Min(1f - nx, dragStartCrop.Width + dx));
                        float newH_NE = dragStartCrop.Height - dy;
                        if (newH_NE >= 0.04f && dragStartCrop.Bottom - newH_NE >= 0f) { ny = dragStartCrop.Bottom - newH_NE; nh = newH_NE; }
                        break;
                    case DragHandle.NW:
                        float newW_NW = dragStartCrop.Width - dx;
                        if (newW_NW >= 0.04f && dragStartCrop.Right - newW_NW >= 0f) { nx = dragStartCrop.Right - newW_NW; nw = newW_NW; }
                        float newH_NW = dragStartCrop.Height - dy;
                        if (newH_NW >= 0.04f && dragStartCrop.Bottom - newH_NW >= 0f) { ny = dragStartCrop.Bottom - newH_NW; nh = newH_NW; }
                        break;
                }

                currentCropNorm = new RectangleF(nx, ny, nw, nh);
                currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
                picPreview.Invalidate();
            }
        };

        picPreview.MouseUp += delegate {
            if (activeDrag != DragHandle.None) {
                activeDrag = DragHandle.None;
                currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
                if (isDrawMode) { isDrawMode = false; bDrawSel.BackColor = Color.White; }
                SaveIni();
            }
        };

        // Keyboard Shortcuts & Nudge Support
        f.KeyDown += delegate(object sender, KeyEventArgs e) {
            if (e.KeyCode == Keys.F6 || e.KeyCode == Keys.F5) {
                if (bPreviewScan != null && bPreviewScan.Enabled) {
                    bPreviewScan.PerformClick();
                    e.Handled = true;
                    return;
                }
            }
            if (e.KeyCode == Keys.F7 || (e.Control && e.KeyCode == Keys.Enter)) {
                if (bScan != null && bScan.Enabled) {
                    bScan.PerformClick();
                    e.Handled = true;
                    return;
                }
            }
            if (e.Control && e.KeyCode == Keys.A) {
                currentCropNorm = new RectangleF(0, 0, 1, 1);
                currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
                picPreview.Invalidate();
                updateSummary();
                e.Handled = true;
                return;
            }
            if (e.Control && e.KeyCode == Keys.D) {
                if (rawPreviewImg != null) currentCropNorm = NormalizeCrop(AutoDetectDocumentBounds(rawPreviewImg));
                picPreview.Invalidate();
                updateSummary();
                e.Handled = true;
                return;
            }
            if (e.Control && e.KeyCode == Keys.R) {
                bResetCrop.PerformClick();
                e.Handled = true;
                return;
            }

            float step = e.Shift ? 0.01f : 0.002f;
            float nx = currentCropNorm.X;
            float ny = currentCropNorm.Y;
            if (e.KeyCode == Keys.Left)  nx = Math.Max(0f, nx - step);
            else if (e.KeyCode == Keys.Right) nx = Math.Min(1f - currentCropNorm.Width, nx + step);
            else if (e.KeyCode == Keys.Up)    ny = Math.Max(0f, ny - step);
            else if (e.KeyCode == Keys.Down)  ny = Math.Min(1f - currentCropNorm.Height, ny + step);
            else return;

            currentCropNorm = NormalizeCrop(new RectangleF(nx, ny, currentCropNorm.Width, currentCropNorm.Height));
            currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
            picPreview.Invalidate();
            updateSummary();
            e.Handled = true;
        };

        // ================= RIGHT PANEL: INSPECTOR (~30%) =================
        int IX = 676;
        int IW = 288;

        ModernCardPanel pInspector = new ModernCardPanel();
        pInspector.Location = new Point(IX, 50);
        pInspector.Size = new Size(IW, 480);
        pInspector.BackColor = Color.White;

        // --- Section 1: Scan settings ---
        Label hScanSettings = new Label();
        hScanSettings.Text = "Scan settings";
        hScanSettings.Font = new Font("Segoe UI", 10f, FontStyle.Bold);
        hScanSettings.ForeColor = Color.FromArgb(31, 31, 31);
        hScanSettings.Location = new Point(12, 10);
        hScanSettings.Size = new Size(180, 20);

        Label lColor = new Label { Text = "Color", Location = new Point(12, 36), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbBits = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 32), Size = new Size(190, 24) };
        
        Action populateColorDropdown = delegate {
            cbBits.Items.Clear();
            cbBits.Items.AddRange(new object[] { 
                "Color (24-bit Full)", 
                "Document Color (Clean BG)", 
                "Photo Color (Vibrant)", 
                "Grayscale (8-bit Gray)", 
                "Black & White (1-bit Binary)"
            });
            List<CustomColorPreset> cList = LoadCustomColorPresets();
            foreach (var cp in cList) {
                cbBits.Items.Add("\u2605 " + cp.Name);
            }
            cbBits.Items.Add("\u2699 Manage Color Presets...");
        };
        populateColorDropdown();
        if (S["bitdepth"] == "gray") cbBits.SelectedIndex = 3;
        else if (S["bitdepth"] == "bw") cbBits.SelectedIndex = 4;
        else cbBits.SelectedIndex = 0;

        Label lDpi = new Label { Text = "Resolution", Location = new Point(12, 66), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbDpi = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 62), Size = new Size(190, 24) };
        cbDpi.Items.AddRange(new object[] { "150 dpi", "200 dpi", "300 dpi", "400 dpi", "600 dpi", "1200 dpi" });
        cbDpi.SelectedItem = S["dpi"] + " dpi";
        if (cbDpi.SelectedIndex < 0) cbDpi.SelectedItem = "300 dpi";

        Label lSrc = new Label { Text = "Source", Location = new Point(12, 96), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbSrc = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 92), Size = new Size(190, 24) };
        cbSrc.Items.AddRange(new object[] { "Glass (Flatbed)", "Feeder", "Duplex" });
        if (S["source"] == "feeder") cbSrc.SelectedIndex = 1;
        else if (S["source"] == "duplex") cbSrc.SelectedIndex = 2;
        else cbSrc.SelectedIndex = 0;

        Label lPreset = new Label { Text = "Preset", Location = new Point(12, 126), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbPreset = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 122), Size = new Size(190, 24) };
        cbPreset.Items.AddRange(new object[] { "Photo / ID card", "Full A4 Document", "Legal", "Letter", "+ Manage Custom Sizes..." });
        if (S.ContainsKey("pagesize")) {
            if (S["pagesize"] == "legal") cbPreset.SelectedIndex = 2;
            else if (S["pagesize"] == "letter") cbPreset.SelectedIndex = 3;
            else if (S["pagesize"] == "id" || S["pagesize"] == "card") cbPreset.SelectedIndex = 0;
            else cbPreset.SelectedIndex = 1;
        } else {
            cbPreset.SelectedIndex = 1;
        }

        Label div1 = new Label { BorderStyle = BorderStyle.Fixed3D, Location = new Point(12, 154), Size = new Size(264, 2) };

        // --- Section 2: Enhancements ---
        Label hEnhancements = new Label();
        hEnhancements.Text = "Enhancements";
        hEnhancements.Font = new Font("Segoe UI", 10f, FontStyle.Bold);
        hEnhancements.ForeColor = Color.FromArgb(31, 31, 31);
        hEnhancements.Location = new Point(12, 164);
        hEnhancements.Size = new Size(180, 20);

        Label lStraighten = new Label { Text = "Auto straighten", Location = new Point(12, 192), Size = new Size(160, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ModernToggle tglStraighten = new ModernToggle { Location = new Point(232, 190), Checked = true };
        tt.SetToolTip(tglStraighten, "Auto-deskew and align document edges (0.00\u00B0)");

        Label lAutoColor = new Label { Text = "Auto color / tone", Location = new Point(12, 222), Size = new Size(160, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ModernToggle tglAutoColor = new ModernToggle { Location = new Point(232, 220), Checked = true };
        tt.SetToolTip(tglAutoColor, "Auto contrast and white balance tone optimization");

        LinkLabel lOpenAdvMaster = new LinkLabel { 
            Text = "\uD83C\uDFA8 Custom Tone & Curves...", 
            Location = new Point(12, 252), 
            Size = new Size(220, 20), 
            LinkColor = Color.FromArgb(20, 115, 230), 
            ActiveLinkColor = Color.FromArgb(10, 80, 180),
            Font = new Font("Segoe UI", 9f, FontStyle.Bold)
        };
        tt.SetToolTip(lOpenAdvMaster, "Open Advanced Photoshop-grade Histogram and Curves Dialog");

        CheckBox cNative = new CheckBox { Text = "Show official scanner driver window", Location = new Point(12, 278), Size = new Size(260, 20), Checked = On("nativeui") };

        Label div2 = new Label { BorderStyle = BorderStyle.Fixed3D, Location = new Point(12, 308), Size = new Size(264, 2) };

        // --- Section 3: Destination ---
        Label hDestination = new Label();
        hDestination.Text = "Destination";
        hDestination.Font = new Font("Segoe UI", 10f, FontStyle.Bold);
        hDestination.ForeColor = Color.FromArgb(31, 31, 31);
        hDestination.Location = new Point(12, 318);
        hDestination.Size = new Size(180, 20);

        Label lFmt = new Label { Text = "Format", Location = new Point(12, 346), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbFmt = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 342), Size = new Size(190, 24) };
        cbFmt.Items.AddRange(new object[] { "JPEG (Standard)", "PNG (Lossless)", "TIFF (Uncompressed)" });
        if (S.ContainsKey("format")) {
            if (S["format"] == "png") cbFmt.SelectedIndex = 1;
            else if (S["format"] == "tif" || S["format"] == "tiff") cbFmt.SelectedIndex = 2;
            else cbFmt.SelectedIndex = 0;
        } else {
            cbFmt.SelectedIndex = 0;
        }

        Label lDestMode = new Label { Text = "Mode", Location = new Point(12, 376), Size = new Size(70, 20), ForeColor = Color.FromArgb(50, 50, 50) };
        ComboBox cbDestMode = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList, Location = new Point(85, 372), Size = new Size(190, 24) };
        cbDestMode.Items.AddRange(new object[] { "Photoshop (New Document)", "Photoshop (New Layer)", "Save File Only" });
        cbDestMode.SelectedIndex = 0;

        pInspector.Controls.AddRange(new Control[] {
            hScanSettings, lColor, cbBits, lDpi, cbDpi, lSrc, cbSrc, lPreset, cbPreset, div1,
            hEnhancements, lStraighten, tglStraighten, lAutoColor, tglAutoColor, lOpenAdvMaster, cNative, div2,
            hDestination, lFmt, cbFmt, lDestMode, cbDestMode
        });

        // ================= BOTTOM ACTION BAR =================
        bPreviewScan.Text = " \u21BB  Preview scan";
        bPreviewScan.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
        bPreviewScan.Location = new Point(16, 566);
        bPreviewScan.Size = new Size(130, 38);
        bPreviewScan.BackColor = Color.White;
        bPreviewScan.ForeColor = Color.FromArgb(31, 31, 31);
        bPreviewScan.FlatStyle = FlatStyle.Flat;
        bPreviewScan.FlatAppearance.BorderColor = Color.FromArgb(200, 205, 215);
        bPreviewScan.Cursor = Cursors.Hand;
        tt.SetToolTip(bPreviewScan, "Acquires quick ~2-second color overview of scanner bed");

        Label lPreviewTime = new Label();
        lPreviewTime.Text = "~2 sec";
        lPreviewTime.ForeColor = Color.FromArgb(120, 120, 120);
        lPreviewTime.Location = new Point(152, 575);
        lPreviewTime.Size = new Size(50, 20);

        Label lSummary = new Label();
        lSummary.Text = "Color \u00B7 300 dpi \u00B7 8.3 \u00D7 10.0 in \u00B7 2490 \u00D7 3000 px \u00B7 ~21 MB";
        lSummary.ForeColor = Color.FromArgb(110, 110, 110);
        lSummary.Font = new Font("Segoe UI", 9f);
        lSummary.TextAlign = ContentAlignment.MiddleRight;
        lSummary.Location = new Point(350, 538);
        lSummary.Size = new Size(614, 20);

        Button bCancel = new Button();
        bCancel.Text = "Cancel";
        bCancel.Font = new Font("Segoe UI", 9.5f);
        bCancel.Location = new Point(676, 566);
        bCancel.Size = new Size(84, 38);
        bCancel.BackColor = Color.White;
        bCancel.ForeColor = Color.FromArgb(31, 31, 31);
        bCancel.FlatStyle = FlatStyle.Flat;
        bCancel.FlatAppearance.BorderColor = Color.FromArgb(200, 205, 215);
        bCancel.Cursor = Cursors.Hand;

        bScan.Text = "Scan to Photoshop";
        bScan.Font = new Font("Segoe UI", 10f, FontStyle.Bold);
        bScan.Location = new Point(768, 566);
        bScan.Size = new Size(196, 38);
        bScan.BackColor = Color.FromArgb(20, 115, 230);
        bScan.ForeColor = Color.White;
        bScan.FlatStyle = FlatStyle.Flat;
        bScan.FlatAppearance.BorderSize = 0;
        bScan.Cursor = Cursors.Hand;
        tt.SetToolTip(bScan, "Scans selected document and opens directly into Adobe Photoshop");

        updateSummary = delegate {
            string bits = "Color";
            if (cbBits.SelectedIndex == 1) bits = "Doc Color";
            else if (cbBits.SelectedIndex == 2) bits = "Photo Vibrant";
            else if (cbBits.SelectedIndex == 3) bits = "Grayscale";
            else if (cbBits.SelectedIndex == 4) bits = "B&W";
            else if (cbBits.SelectedIndex >= 5 && cbBits.SelectedIndex < cbBits.Items.Count - 1) bits = "Custom";

            string dpiStr = cbDpi.SelectedItem.ToString().Replace(" dpi", "");
            int dpiVal = 300;
            int.TryParse(dpiStr, out dpiVal);

            float w = currentCropNorm.Width * 8.27f;
            float h = currentCropNorm.Height * 11.69f;
            int pxW = (int)Math.Round(w * dpiVal);
            int pxH = (int)Math.Round(h * dpiVal);
            double mbSize = (pxW * pxH * 3.0) / (1024.0 * 1024.0);

            lSummary.Text = bits + " \u00B7 " + dpiVal + " dpi \u00B7 " + w.ToString("0.#") + " \u00D7 " + h.ToString("0.#") + " in \u00B7 " + pxW + " \u00D7 " + pxH + " px \u00B7 ~" + mbSize.ToString("0.#") + " MB";
        };

        cbBits.SelectedIndexChanged += delegate {
            int sel = cbBits.SelectedIndex;
            if (sel == 0) {
                currentColorMode = PreviewColorMode.Color24;
                currentCustomPreset = null;
                S["bitdepth"] = "color";
            } else if (sel == 1) {
                currentColorMode = PreviewColorMode.DocumentColor;
                currentCustomPreset = null;
                S["bitdepth"] = "color";
            } else if (sel == 2) {
                currentColorMode = PreviewColorMode.PhotoVibrant;
                currentCustomPreset = null;
                S["bitdepth"] = "color";
            } else if (sel == 3) {
                currentColorMode = PreviewColorMode.Grayscale8;
                currentCustomPreset = null;
                S["bitdepth"] = "gray";
            } else if (sel == 4) {
                currentColorMode = PreviewColorMode.BlackAndWhite1;
                currentCustomPreset = null;
                S["bitdepth"] = "bw";
            } else if (sel == cbBits.Items.Count - 1) {
                // Open Advanced Tone Dialog
                ShowAdvancedToneDialog(f, rawPreviewImg, currentCustomPreset, delegate(CustomColorPreset applied) {
                    currentCustomPreset = applied;
                    currentColorMode = PreviewColorMode.Custom;
                    S["colormode"] = currentColorMode.ToString();
                    S["custompreset"] = currentCustomPreset.Serialize();
                    if (currentCustomPreset.IsBW) S["bitdepth"] = "bw";
                    else if (currentCustomPreset.IsGrayscale) S["bitdepth"] = "gray";
                    else S["bitdepth"] = "color";
                    SaveIni();
                    applyLiveFilters();
                    updateSummary();
                }, delegate {
                    populateColorDropdown();
                });
            } else {
                // Picked a custom preset from list
                List<CustomColorPreset> cList = LoadCustomColorPresets();
                int cIdx = sel - 5;
                if (cIdx >= 0 && cIdx < cList.Count) {
                    currentCustomPreset = cList[cIdx];
                    currentColorMode = PreviewColorMode.Custom;
                    if (currentCustomPreset.IsBW) S["bitdepth"] = "bw";
                    else if (currentCustomPreset.IsGrayscale) S["bitdepth"] = "gray";
                    else S["bitdepth"] = "color";
                }
            }
            S["colormode"] = currentColorMode.ToString();
            S["custompreset"] = (currentCustomPreset != null) ? currentCustomPreset.Serialize() : "";
            SaveIni();
            updateSummary();
            applyLiveFilters();
        };

        lOpenAdvMaster.Click += delegate {
            ShowAdvancedToneDialog(f, rawPreviewImg, currentCustomPreset, delegate(CustomColorPreset applied) {
                currentCustomPreset = applied;
                currentColorMode = PreviewColorMode.Custom;
                S["colormode"] = currentColorMode.ToString();
                S["custompreset"] = currentCustomPreset.Serialize();
                if (currentCustomPreset.IsBW) S["bitdepth"] = "bw";
                else if (currentCustomPreset.IsGrayscale) S["bitdepth"] = "gray";
                else S["bitdepth"] = "color";
                SaveIni();
                applyLiveFilters();
                updateSummary();
            }, delegate {
                populateColorDropdown();
            });
        };

        tglAutoColor.CheckedChanged += delegate {
            S["autocolor"] = tglAutoColor.Checked ? "on" : "off";
            SaveIni();
            applyLiveFilters();
        };

        tglStraighten.CheckedChanged += delegate {
            S["deskew"] = tglStraighten.Checked ? "on" : "off";
            SaveIni();
            applyLiveFilters();
        };

        cbDpi.SelectedIndexChanged += delegate {
            S["dpi"] = cbDpi.SelectedItem.ToString().Replace(" dpi", "");
            SaveIni();
            updateSummary();
            picPreview.Invalidate();
        };

        cbSrc.SelectedIndexChanged += delegate {
            if (cbSrc.SelectedIndex == 1) S["source"] = "feeder";
            else if (cbSrc.SelectedIndex == 2) S["source"] = "duplex";
            else S["source"] = "glass";
            SaveIni();
        };

        cbFmt.SelectedIndexChanged += delegate {
            if (cbFmt.SelectedIndex == 1) S["format"] = "png";
            else if (cbFmt.SelectedIndex == 2) S["format"] = "tif";
            else S["format"] = "jpg";
            SaveIni();
        };

        cbDestMode.SelectedIndexChanged += delegate {
            if (cbDestMode.SelectedIndex == 2) {
                bScan.Text = "Scan & Save File";
                S["openinps"] = "off";
            } else {
                bScan.Text = "Scan to Photoshop";
                S["openinps"] = "on";
            }
            SaveIni();
        };

        cbPreset.SelectedIndexChanged += delegate {
            currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
            if (cbPreset.SelectedIndex == 0) {
                currentCropNorm = NormalizeCrop(new RectangleF(0.25f, 0.05f, 0.5f, 0.32f)); // ID card
                S["pagesize"] = "a4";
            }
            else if (cbPreset.SelectedIndex == 1) {
                currentCropNorm = NormalizeCrop(new RectangleF(0f, 0f, 1f, 1f)); // Full A4
                S["pagesize"] = "a4";
            }
            else if (cbPreset.SelectedIndex == 2) {
                currentCropNorm = NormalizeCrop(new RectangleF(0f, 0f, 1f, 1f)); // Legal
                S["pagesize"] = "legal";
            }
            else if (cbPreset.SelectedIndex == 3) {
                currentCropNorm = NormalizeCrop(new RectangleF(0f, 0f, 1f, 0.95f)); // Letter
                S["pagesize"] = "letter";
            }
            else if (cbPreset.SelectedIndex == 4) {
                ShowCustomSizeManager(f, delegate {
                    // reloaded
                });
            }
            SaveIni();
            picPreview.Invalidate();
            updateSummary();
        };

        bAutoDetect.Click += delegate {
            if (rawPreviewImg == null) return;
            currentCropNorm = AutoDetectDocumentBounds(rawPreviewImg);
            segBedSelection.SelectedIndex = 1;
            picPreview.Invalidate();
            updateSummary();
        };

        bDrawSel.Click += delegate {
            isDrawMode = !isDrawMode;
            bDrawSel.BackColor = isDrawMode ? Color.FromArgb(225, 238, 255) : Color.White;
            picPreview.Cursor = isDrawMode ? Cursors.Cross : Cursors.Default;
        };

        bRotate.Click += delegate {
            if (rawPreviewImg != null) {
                rawPreviewImg.RotateFlip(RotateFlipType.Rotate90FlipNone);
                currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
                applyLiveFilters();
            }
        };

        bFit.Click += delegate {
            picPreview.SizeMode = PictureBoxSizeMode.Zoom;
            picPreview.Invalidate();
        };

        bZoom100.Click += delegate {
            picPreview.SizeMode = PictureBoxSizeMode.CenterImage;
            picPreview.Invalidate();
        };

        bResetCrop.Click += delegate {
            currentCropNorm = new RectangleF(0f, 0f, 1f, 1f);
            currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
            segBedSelection.SelectedIndex = 0;
            picPreview.Invalidate();
            updateSummary();
        };

        segBedSelection.SelectedIndexChanged += delegate {
            if (segBedSelection.SelectedIndex == 0) {
                currentCropNorm = new RectangleF(0f, 0f, 1f, 1f);
                currentRotatedBox = new RotatedDocBox { IsValid = false, Angle = 0f };
            } else {
                if (rawPreviewImg != null) {
                    currentCropNorm = AutoDetectDocumentBounds(rawPreviewImg);
                }
            }
            picPreview.Invalidate();
            updateSummary();
        };

        List<Dev> devs = LoadCachedDevices();
        MethodInvoker fillDevs = delegate {
            cbDev.Items.Clear();
            foreach (Dev d in devs) cbDev.Items.Add(d);
            for (int i = 0; i < devs.Count; i++) {
                if (devs[i].Name == S["device"] && devs[i].Driver == S["driver"]) {
                    cbDev.SelectedIndex = i; break;
                }
            }
            if (cbDev.SelectedIndex < 0 && cbDev.Items.Count > 0) cbDev.SelectedIndex = 0;
            if (devs.Count > 0) {
                lReady.Text = "\u25CF Ready";
                lReady.ForeColor = Color.FromArgb(22, 163, 74);
                bScan.Enabled = true;
            } else {
                lReady.Text = "\u25CF Scanner unavailable";
                lReady.ForeColor = Color.FromArgb(220, 38, 38);
                bScan.Enabled = false;
            }
            updateSummary();
        };
        fillDevs();

        cbDev.SelectedIndexChanged += delegate {
            Dev d = cbDev.SelectedItem as Dev;
            if (d != null) {
                S["driver"] = d.Driver;
                S["device"] = d.Name;
                SaveIni();
            }
        };

        // Asynchronous Fast Preview Scan with Real-Time Laser Carriage Animation
        bPreviewScan.Click += delegate {
            Dev d = cbDev.SelectedItem as Dev;
            if (d == null) {
                MessageBox.Show("Please select a scanner first.", "Preview");
                return;
            }

            isPreviewRunning = true;
            scanProgress = 0f;
            scanStartTime = DateTime.Now;
            scanAnimTimer.Start();

            bPreviewScan.Enabled = false;
            bScan.Enabled = false;
            bAutoDetect.Enabled = false;
            bDrawSel.Enabled = false;
            lReady.Text = "\u25CF Scanning...";
            lReady.ForeColor = Color.FromArgb(20, 115, 230);
            picPreview.Invalidate();

            ThreadPool.QueueUserWorkItem(delegate {
                bool ok = DoPreviewScan(naps2, d.Name, d.Driver);
                try {
                    f.BeginInvoke((MethodInvoker)delegate {
                        scanAnimTimer.Stop();
                        isPreviewRunning = false;
                        scanProgress = 1.0f;

                        bPreviewScan.Enabled = true;
                        bScan.Enabled = true;
                        bAutoDetect.Enabled = true;
                        bDrawSel.Enabled = true;
                        lReady.Text = "\u25CF Ready";
                        lReady.ForeColor = Color.FromArgb(22, 163, 74);

                        if (ok) {
                            reloadCachedPreview();
                            if (rawPreviewImg != null) {
                                RectangleF autoBounds = AutoDetectDocumentBounds(rawPreviewImg);
                                currentCropNorm = autoBounds;
                                segBedSelection.SelectedIndex = 1;
                            }
                            applyLiveFilters();
                            SaveIni();
                            updateSummary();
                        } else {
                            MessageBox.Show("Preview could not be acquired. Please ensure scanner is connected and not in use by another app.", "Scanner Preview");
                        }
                    });
                } catch { }
            });
        };

        bScan.Click += delegate {
            Dev d = cbDev.SelectedItem as Dev;
            if (d != null) { S["driver"] = d.Driver; S["device"] = d.Name; }
            S["nativeui"] = cNative.Checked ? "on" : "off";
            S["deskew"]   = tglStraighten.Checked ? "on" : "off";
            S["autocolor"] = tglAutoColor.Checked ? "on" : "off";
            S["dpi"]      = cbDpi.SelectedItem.ToString().Replace(" dpi", "");
            
            if (cbBits.SelectedIndex == 3) S["bitdepth"] = "gray";
            else if (cbBits.SelectedIndex == 4) S["bitdepth"] = "bw";
            else S["bitdepth"] = "color";

            S["colormode"] = currentColorMode.ToString();
            S["custompreset"] = (currentCustomPreset != null) ? currentCustomPreset.Serialize() : "";

            if (cbSrc.SelectedIndex == 1) S["source"] = "feeder";
            else if (cbSrc.SelectedIndex == 2) S["source"] = "duplex";
            else S["source"] = "glass";
            
            if (cbPreset.SelectedIndex == 2) S["pagesize"] = "legal";
            else if (cbPreset.SelectedIndex == 3) S["pagesize"] = "letter";
            else if (cbPreset.SelectedIndex == 0 || cbPreset.SelectedIndex == 1) S["pagesize"] = "a4";

            if (cbFmt.SelectedIndex == 1) S["format"] = "png";
            else if (cbFmt.SelectedIndex == 2) S["format"] = "tif";
            else S["format"] = "jpg";

            S["openinps"] = (cbDestMode.SelectedIndex != 2) ? "on" : "off";
            SaveIni();
            go = true;
            f.Close();
        };

        bCancel.Click += delegate { go = false; f.Close(); };

        f.AcceptButton = bScan;
        f.CancelButton = bCancel;
        f.Controls.AddRange(new Control[] {
            pTop,
            bAutoDetect, bDrawSel, bRotate, bFit, bZoom100, bResetCrop, segBedSelection,
            pCanvasFrame,
            pInspector,
            bPreviewScan, lPreviewTime, lSummary, bCancel, bScan
        });

        IntPtr psHwnd = IntPtr.Zero;
        try {
            Process[] psList = Process.GetProcessesByName("Photoshop");
            if (psList.Length > 0) psHwnd = psList[0].MainWindowHandle;
        } catch { }

        if (psHwnd != IntPtr.Zero) {
            f.ShowDialog(new Win32WindowWrapper(psHwnd));
        } else {
            f.ShowDialog();
        }
        return go;
    }

    // ================= main entry =================
    [STAThread]
    public static void Main(string[] args)
    {
        CleanupStaleScannerProcesses();
        LoadIni();
        try { if (File.Exists(LOG) && new FileInfo(LOG).Length > 200000) File.Delete(LOG); }
        catch { }
        L("=== Scanner Bridge Start ===");

        bool noDialog = false;
        bool quick = false;
        bool wiaOnly = false;
        bool isFromJsx = false;

        for (int i = 0; i < args.Length; i++) {
            string a = args[i].ToLower();
            if (a == "-nodialog" || a == "-silent") noDialog = true;
            else if (a == "-quick") quick = true;
            else if (a == "-wia") wiaOnly = true;
            else if (a == "-jsx") isFromJsx = true;
            else if (a == "-testcv") {
                if (File.Exists(PREVIEW)) {
                    using (Image img = Image.FromFile(PREVIEW)) {
                        RectangleF r = AutoDetectDocumentBounds(img);
                        L("TESTCV: Bounds=" + r);
                        Console.WriteLine("Bounds: " + r);
                    }
                } else {
                    L("TESTCV: No preview cache file at " + PREVIEW);
                    Console.WriteLine("No preview cache file at " + PREVIEW);
                }
                return;
            }
            else if ((a == "-device" || a == "--device") && i + 1 < args.Length) {
                S["device"] = args[++i];
            }
            else if ((a == "-driver" || a == "--driver") && i + 1 < args.Length) {
                S["driver"] = args[++i].ToLower();
            }
            else if ((a == "-dpi" || a == "--dpi") && i + 1 < args.Length) {
                S["dpi"] = args[++i];
            }
            else if ((a == "-bitdepth" || a == "--bitdepth") && i + 1 < args.Length) {
                S["bitdepth"] = args[++i].ToLower();
            }
            else if ((a == "-source" || a == "--source") && i + 1 < args.Length) {
                S["source"] = args[++i].ToLower();
            }
            else if ((a == "-pagesize" || a == "--pagesize" || a == "-size") && i + 1 < args.Length) {
                S["pagesize"] = args[++i].ToLower();
            }
            else if ((a == "-format" || a == "--format") && i + 1 < args.Length) {
                S["format"] = args[++i].ToLower();
            }
            else if ((a == "-nativeui" || a == "--nativeui") && i + 1 < args.Length) {
                S["nativeui"] = args[++i].ToLower();
            }
            else if ((a == "-deskew" || a == "--deskew") && i + 1 < args.Length) {
                S["deskew"] = args[++i].ToLower();
            }
        }

        Application.EnableVisualStyles();
        string naps2 = FindNaps2();
        L("naps2 path: " + (naps2.Length > 0 ? naps2 : "(not found)"));

        string outPath = BuildOutPath();
        List<string> scannedFiles = new List<string>();

        IntPtr psHwnd = IntPtr.Zero;
        try {
            Process[] psList = Process.GetProcessesByName("Photoshop");
            if (psList.Length > 0) psHwnd = psList[0].MainWindowHandle;
        } catch { }

        if (wiaOnly || naps2.Length == 0) {
            scannedFiles = WiaScan(outPath);
        } else {
            if (!noDialog && !quick) {
                if (!ShowDialog(naps2)) { L("user cancelled scan dialog"); SetStatus("CANCELLED"); return; }
            } else if (S["device"].Length == 0) {
                if (!ShowDialog(naps2)) { SetStatus("CANCELLED"); return; }
            }

            scannedFiles = ShowScanningProgressModal(psHwnd, naps2, outPath);
        }

        if (scannedFiles.Count == 0) {
            L("no image acquired, exiting silently");
            SetStatus("CANCELLED");
            return;
        }

        foreach (string f in scannedFiles) {
            L("acquired: " + f + " (" + Math.Round(new FileInfo(f).Length / 1024.0) + " KB)");
        }

        WriteOutputList(scannedFiles);
        SaveIni();

        if (isFromJsx) {
            SetStatus("DONE");
            BringPhotoshopToFront();
        } else {
            if (On("openinps")) {
                OpenInPhotoshop(scannedFiles);
            }
            SetStatus("DONE");
        }

        if (!On("keepfiles")) {
            foreach (string f in scannedFiles) {
                try { File.Delete(f); } catch { }
            }
        }
    }
}