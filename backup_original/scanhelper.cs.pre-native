        Panel pPreviewToolbar = new Panel { Dock = DockStyle.Top, Height = 32, BackColor = Color.FromArgb(30, 36, 48) };
        pPreviewLeft.Controls.Add(pPreviewToolbar);

        // Comparison mode buttons
        int compMode = 0; // 0=Adjusted, 1=Original, 2=Split View, 3=Side-by-Side
