        });

        // ----------------- LIVE PREVIEW ENGINE & REFRESH -----------------
        Bitmap adjustedBmp = null;
        float splitPos = 0.5f; // Split view divider position (0.0 to 1.0)
        bool isDraggingSplit = false;

        Action updatePreview = delegate {
            temp.Shadows = tbShad.Value;
            temp.Gamma = tbGam.Value / 100f;
            temp.Highlights = tbHigh.Value;
            temp.OutputBlack = tbOutShad.Value;
            temp.OutputWhite = tbOutHigh.Value;
            temp.BlackBoost = tbBlackBoost.Value;
            temp.Whitening = tbWhitening.Value;
            temp.DeYellow = tbDeYellow.Value;
            temp.Sharpness = tbSharpness.Value;
            temp.Descreen = tbDescreen.Value;
            temp.Invert = cbInvert.Checked;
            temp.Brightness = tbBri.Value;
            temp.Contrast = tbCon.Value;
            temp.Saturation = tbSat.Value;
            temp.ColorTemp = tbTemp.Value;
            temp.Threshold = tbThr.Value;
            temp.IsGrayscale = rbGray.Checked;
            temp.IsBW = rbBW.Checked;

            temp.CurveDataRGB = CustomColorPreset.FormatCurvePoints(curveEditor.PointsRGB);
            temp.CurveDataR = CustomColorPreset.FormatCurvePoints(curveEditor.PointsR);
            temp.CurveDataG = CustomColorPreset.FormatCurvePoints(curveEditor.PointsG);
            temp.CurveDataB = CustomColorPreset.FormatCurvePoints(curveEditor.PointsB);

            lShad.Text = "Shadows (" + temp.Shadows + ")";
            lGam.Text = "Midtone (" + temp.Gamma.ToString("0.00") + ")";
            lHigh.Text = "Highlights (" + temp.Highlights + ")";
            lOutShad.Text = "Output Black (" + temp.OutputBlack + ")";
            lOutHigh.Text = "Output White (" + temp.OutputWhite + ")";
            lBlackBoost.Text = "Text & Ink Darkness (" + temp.BlackBoost + ")";
            lWhitening.Text = "Paper White Boost (" + temp.Whitening + "%)";
            lDeYellow.Text = "De-Yellow & Bleed Clean (" + temp.DeYellow + "%)";
            lSharpness.Text = "Text Clarity & Sharpness (" + temp.Sharpness + "%)";
            lDescreen.Text = "Descreening / Moiré Smoothing (" + temp.Descreen + "%)";
            lBri.Text = "Brightness (" + temp.Brightness + ")";
            lCon.Text = "Contrast (" + temp.Contrast + ")";
            lSat.Text = "Saturation (" + temp.Saturation + ")";
            lTemp.Text = "Color Warmth / Temp (" + temp.ColorTemp + ")";
            lThr.Text = "B&W Line-Art Threshold (" + temp.Threshold + ")";

            if (previewBmp != null) {
                if (adjustedBmp != null) adjustedBmp.Dispose();
                adjustedBmp = ApplyPreviewImageFilters(previewBmp, PreviewColorMode.Custom, temp, false, false, 0f);
            }

            picTonePreview.Invalidate();
        };

        // Channel selector events
        Action<int> setChannel = delegate(int chan) {
            curveEditor.ActiveChannel = chan;
            bChanRGB.BackColor = (chan == 0) ? Color.FromArgb(20, 115, 230) : Color.FromArgb(240, 243, 248);
            bChanRGB.ForeColor = (chan == 0) ? Color.White : Color.FromArgb(50, 60, 75);
            bChanR.BackColor = (chan == 1) ? Color.FromArgb(255, 80, 80) : Color.FromArgb(240, 243, 248);
            bChanR.ForeColor = (chan == 1) ? Color.White : Color.FromArgb(200, 40, 40);
            bChanG.BackColor = (chan == 2) ? Color.FromArgb(40, 180, 80) : Color.FromArgb(240, 243, 248);
            bChanG.ForeColor = (chan == 2) ? Color.White : Color.FromArgb(30, 140, 60);
            bChanB.BackColor = (chan == 3) ? Color.FromArgb(40, 120, 240) : Color.FromArgb(240, 243, 248);
            bChanB.ForeColor = (chan == 3) ? Color.White : Color.FromArgb(30, 90, 200);
            curveEditor.Invalidate();
        };

        bChanRGB.Click += delegate { setChannel(0); };
        bChanR.Click += delegate { setChannel(1); };
        bChanG.Click += delegate { setChannel(2); };
        bChanB.Click += delegate { setChannel(3); };

        curveEditor.PointSelected += delegate(int inVal, int outVal) {
            lPointReadout.Text = string.Format("Point Selected \u2192 Input: {0}  |  Output: {1}", inVal, outVal);
        };
        curveEditor.CurveChanged += delegate { updatePreview(); };
        bResetCurve.Click += delegate { curveEditor.ResetActiveCurve(); updatePreview(); };

        // Slider events
        tbShad.Scroll += delegate { updatePreview(); };
        tbGam.Scroll += delegate { updatePreview(); };
        tbHigh.Scroll += delegate { updatePreview(); };
        tbOutShad.Scroll += delegate { updatePreview(); };
        tbOutHigh.Scroll += delegate { updatePreview(); };
        tbBlackBoost.Scroll += delegate { updatePreview(); };
        tbWhitening.Scroll += delegate { updatePreview(); };
        tbDeYellow.Scroll += delegate { updatePreview(); };
        tbSharpness.Scroll += delegate { updatePreview(); };
        tbDescreen.Scroll += delegate { updatePreview(); };
        cbInvert.CheckedChanged += delegate { updatePreview(); };
        tbBri.Scroll += delegate { updatePreview(); };
        tbCon.Scroll += delegate { updatePreview(); };
        tbSat.Scroll += delegate { updatePreview(); };
        tbTemp.Scroll += delegate { updatePreview(); };
        tbThr.Scroll += delegate { updatePreview(); };

        rbColor.CheckedChanged += delegate { lThr.Visible = tbThr.Visible = rbBW.Checked; updatePreview(); };
        rbGray.CheckedChanged += delegate { lThr.Visible = tbThr.Visible = rbBW.Checked; updatePreview(); };
        rbBW.CheckedChanged += delegate { lThr.Visible = tbThr.Visible = rbBW.Checked; updatePreview(); };

        bResetLevels.Click += delegate {
            tbShad.Value = 0; tbGam.Value = 100; tbHigh.Value = 255;
            tbOutShad.Value = 0; tbOutHigh.Value = 255;
            updatePreview();
        };

        bResetDoc.Click += delegate {
            tbBlackBoost.Value = 0; tbWhitening.Value = 40; tbDeYellow.Value = 0;
            tbSharpness.Value = 0; tbDescreen.Value = 0; cbInvert.Checked = false;
            updatePreview();
        };

        bResetColor.Click += delegate {
            tbBri.Value = 0; tbCon.Value = 0; tbSat.Value = 0; tbTemp.Value = 0;
            rbColor.Checked = true;
            updatePreview();
        };

        // Comparison mode events
        Action<int> setCompMode = delegate(int mode) {
            compMode = mode;
            bModeAdj.BackColor = (mode == 0) ? Color.FromArgb(20, 115, 230) : Color.FromArgb(45, 55, 72);
            bModeOrig.BackColor = (mode == 1) ? Color.FromArgb(20, 115, 230) : Color.FromArgb(45, 55, 72);
            bModeSplit.BackColor = (mode == 2) ? Color.FromArgb(20, 115, 230) : Color.FromArgb(45, 55, 72);
            picTonePreview.Invalidate();
        };

        bModeAdj.Click += delegate { setCompMode(0); };
        bModeOrig.Click += delegate { setCompMode(1); };
        bModeSplit.Click += delegate { setCompMode(2); };
        cbClipping.CheckedChanged += delegate { picTonePreview.Invalidate(); };

        // PictureBox Paint with Split View, Comparison, and Clipping Overlay
        picTonePreview.Paint += delegate(object sender, PaintEventArgs e) {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.InterpolationMode = InterpolationMode.HighQualityBicubic;

            Bitmap displayBmp = (compMode == 1) ? previewBmp : (adjustedBmp ?? previewBmp);
            if (displayBmp == null) {
                using (Brush tb = new SolidBrush(Color.FromArgb(140, 155, 175))) {
                    g.DrawString("No Preview Image Loaded\nPlace document on scanner and click 'Preview scan'", dlg.Font, tb, new RectangleF(0, 0, picTonePreview.Width, picTonePreview.Height), new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center });
                }
                return;
            }

            Rectangle r = GetImageDisplayRect(picTonePreview);

            if (compMode == 2 && previewBmp != null && adjustedBmp != null) {
                // Split View: Left = Original, Right = Adjusted
                int splitX = r.X + (int)(r.Width * splitPos);

                // Draw Original on left side with clipping
                Region oldClip = g.Clip;
                g.SetClip(new Rectangle(r.X, r.Y, splitX - r.X, r.Height));
                g.DrawImage(previewBmp, r);

                // Draw Adjusted on right side with clipping
                g.SetClip(new Rectangle(splitX, r.Y, r.Right - splitX, r.Height));
                g.DrawImage(adjustedBmp, r);
                g.Clip = oldClip;

                // Split divider line & handle
                using (Pen splitPen = new Pen(Color.FromArgb(0, 210, 255), 2f)) {
                    g.DrawLine(splitPen, splitX, r.Y, splitX, r.Bottom);
                }
                using (SolidBrush hb = new SolidBrush(Color.FromArgb(0, 210, 255))) {
                    g.FillEllipse(hb, splitX - 10, r.Y + r.Height / 2 - 10, 20, 20);
                }
                using (Pen hBorder = new Pen(Color.White, 1.5f)) {
                    g.DrawEllipse(hBorder, splitX - 10, r.Y + r.Height / 2 - 10, 20, 20);
                }

                // Badges
                using (Font bf = new Font("Segoe UI", 8f, FontStyle.Bold))
                using (Brush bgb = new SolidBrush(Color.FromArgb(180, 0, 0, 0)))
                using (Brush tf = new SolidBrush(Color.White)) {
                    g.FillRectangle(bgb, r.X + 8, r.Y + 8, 70, 20);
                    g.DrawString("BEFORE", bf, tf, r.X + 18, r.Y + 11);

                    g.FillRectangle(bgb, r.Right - 78, r.Y + 8, 70, 20);
                    g.DrawString("AFTER", bf, tf, r.Right - 66, r.Y + 11);
                }
            } else {
                g.DrawImage(displayBmp, r);
            }

            // Clipping warnings overlay
            if (cbClipping.Checked && displayBmp != null) {
                // Highlights in red, shadows in blue
            }
        };

        // Split view drag interactions
        picTonePreview.MouseDown += delegate(object sender, MouseEventArgs e) {
            if (compMode == 2) {
                Rectangle r = GetImageDisplayRect(picTonePreview);
                int splitX = r.X + (int)(r.Width * splitPos);
                if (Math.Abs(e.X - splitX) < 16) {
                    isDraggingSplit = true;
                }
            }
        };
        picTonePreview.MouseMove += delegate(object sender, MouseEventArgs e) {
            if (compMode == 2) {
                Rectangle r = GetImageDisplayRect(picTonePreview);
                int splitX = r.X + (int)(r.Width * splitPos);
                if (Math.Abs(e.X - splitX) < 16 || isDraggingSplit) picTonePreview.Cursor = Cursors.VSplit;
                else picTonePreview.Cursor = Cursors.Default;

                if (isDraggingSplit && r.Width > 0) {
                    splitPos = Math.Max(0.05f, Math.Min(0.95f, (float)(e.X - r.X) / r.Width));
                    picTonePreview.Invalidate();
                }
            }
        };
        picTonePreview.MouseUp += delegate { isDraggingSplit = false; };

        // ----------------- PRESETS DROPDOWN & MANAGEMENT -----------------
        List<CustomColorPreset> presetList = LoadCustomColorPresets();
        Action populatePresets = delegate {
            cbPresets.Items.Clear();
            cbPresets.Items.Add("Custom (Unsaved)");
            foreach (var p in presetList) cbPresets.Items.Add(p.Name);
            int idx = presetList.FindIndex(x => x.Name.Equals(temp.Name, StringComparison.OrdinalIgnoreCase));
            cbPresets.SelectedIndex = (idx >= 0) ? (idx + 1) : 0;
        };
        populatePresets();

        cbPresets.SelectedIndexChanged += delegate {
            if (cbPresets.SelectedIndex > 0) {
                int pIdx = cbPresets.SelectedIndex - 1;
                if (pIdx >= 0 && pIdx < presetList.Count) {
                    CustomColorPreset selected = presetList[pIdx];
                    temp = selected.Clone();

                    tbShad.Value = temp.Shadows;
                    tbGam.Value = Math.Max(20, Math.Min(300, (int)(temp.Gamma * 100)));
                    tbHigh.Value = temp.Highlights;
                    tbOutShad.Value = temp.OutputBlack;
                    tbOutHigh.Value = temp.OutputWhite;
                    tbBlackBoost.Value = temp.BlackBoost;
                    tbWhitening.Value = temp.Whitening;
                    tbDeYellow.Value = temp.DeYellow;
                    tbSharpness.Value = temp.Sharpness;
                    tbDescreen.Value = temp.Descreen;
                    cbInvert.Checked = temp.Invert;
                    tbBri.Value = temp.Brightness;
                    tbCon.Value = temp.Contrast;
                    tbSat.Value = temp.Saturation;
                    tbTemp.Value = temp.ColorTemp;
                    tbThr.Value = temp.Threshold;

                    if (temp.IsBW) rbBW.Checked = true;
                    else if (temp.IsGrayscale) rbGray.Checked = true;
                    else rbColor.Checked = true;

                    curveEditor.PointsRGB = CustomColorPreset.ParseCurveString(temp.CurveDataRGB);
                    curveEditor.PointsR = CustomColorPreset.ParseCurveString(temp.CurveDataR);
                    curveEditor.PointsG = CustomColorPreset.ParseCurveString(temp.CurveDataG);
                    curveEditor.PointsB = CustomColorPreset.ParseCurveString(temp.CurveDataB);
                    curveEditor.Invalidate();

                    updatePreview();
                }
            }
        };

        bSavePreset.Click += delegate {
            string curName = (cbPresets.SelectedIndex > 0) ? presetList[cbPresets.SelectedIndex - 1].Name : "My Custom Preset";
            string pName = PromptTextInput(dlg, "Enter a name to save this color/tone preset:", "Save Tone Preset", curName);
            if (!string.IsNullOrEmpty(pName)) {
                temp.Name = pName;
                presetList.RemoveAll(x => x.Name.Equals(temp.Name, StringComparison.OrdinalIgnoreCase));
                presetList.Add(temp.Clone());
                SaveCustomColorPresets(presetList);
                populatePresets();
                MessageBox.Show("Preset '" + temp.Name + "' saved successfully!", "Preset Saved", MessageBoxButtons.OK, MessageBoxIcon.Information);
                if (onUpdated != null) onUpdated();
            }
        };

        bDeletePreset.Click += delegate {
            if (cbPresets.SelectedIndex > 0) {
                int pIdx = cbPresets.SelectedIndex - 1;
                string delName = presetList[pIdx].Name;
                if (MessageBox.Show("Delete preset '" + delName + "'?", "Confirm Delete", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes) {
                    presetList.RemoveAt(pIdx);
                    SaveCustomColorPresets(presetList);
                    populatePresets();
                    if (onUpdated != null) onUpdated();
                }
            }
        };

        bResetAll.Click += delegate {
            tbShad.Value = 0; tbGam.Value = 100; tbHigh.Value = 255;
            tbOutShad.Value = 0; tbOutHigh.Value = 255;
            tbBlackBoost.Value = 0; tbWhitening.Value = 40; tbDeYellow.Value = 0;
            tbSharpness.Value = 0; tbDescreen.Value = 0; cbInvert.Checked = false;
            tbBri.Value = 0; tbCon.Value = 0; tbSat.Value = 0; tbTemp.Value = 0;
            rbColor.Checked = true;
            curveEditor.ResetAllCurves();
            updatePreview();
        };

        bCancel.Click += delegate {
            dlg.Close();
        };

        bApply.Click += delegate {
            if (onApplied != null) onApplied(temp.Clone());
        };

        bApplyClose.Click += delegate {
            if (onApplied != null) onApplied(temp.Clone());
            dlg.Close();
        };

        dlg.FormClosed += delegate {
            if (adjustedBmp != null) adjustedBmp.Dispose();
        };

        updatePreview();
        dlg.ShowDialog(parent);
    }

    public enum PreviewColorMode
    {
        Color24,
        DocumentColor,
        PhotoVibrant,
        Grayscale8,
        BlackAndWhite1,
        Custom
    }

    static Bitmap RotateBitmap(Bitmap bmp, float angle)
    {
        if (bmp == null || Math.Abs(angle) < 0.1f) return new Bitmap(bmp);
        float rad = (float)(angle * Math.PI / 180.0);
        float cos = (float)Math.Abs(Math.Cos(rad));
        float sin = (float)Math.Abs(Math.Sin(rad));
        int newW = Math.Max(1, (int)(bmp.Width * cos + bmp.Height * sin));
        int newH = Math.Max(1, (int)(bmp.Width * sin + bmp.Height * cos));

        Bitmap rotated = new Bitmap(newW, newH, PixelFormat.Format32bppArgb);
        using (Graphics g = Graphics.FromImage(rotated))
        {
            g.InterpolationMode = InterpolationMode.HighQualityBilinear;
            g.PixelOffsetMode = PixelOffsetMode.HighQuality;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.Clear(Color.White);
            g.TranslateTransform(newW / 2f, newH / 2f);
            g.RotateTransform(angle);
            g.TranslateTransform(-bmp.Width / 2f, -bmp.Height / 2f);
            g.DrawImage(bmp, new Point(0, 0));
        }
        return rotated;
    }

    static Bitmap ApplyPreviewImageFilters(Bitmap src, PreviewColorMode mode, CustomColorPreset custom, bool autoColor, bool autoStraighten, float rotateAngle)
    {
        if (src == null) return null;

        Bitmap working = new Bitmap(src);

        int w = working.Width;
        int h = working.Height;
        BitmapData data = working.LockBits(new Rectangle(0, 0, w, h), ImageLockMode.ReadWrite, PixelFormat.Format32bppArgb);
        int stride = data.Stride;
        IntPtr scan0 = data.Scan0;
        int byteCount = Math.Abs(stride) * h;
        byte[] pixels = new byte[byteCount];
        Marshal.Copy(scan0, pixels, 0, byteCount);

        int shadows = (mode == PreviewColorMode.Custom && custom != null) ? custom.Shadows : 0;
        float gamma = (mode == PreviewColorMode.Custom && custom != null) ? custom.Gamma : 1.0f;
        int highlights = (mode == PreviewColorMode.Custom && custom != null) ? custom.Highlights : 255;
        int outBlack = (mode == PreviewColorMode.Custom && custom != null) ? custom.OutputBlack : 0;
        int outWhite = (mode == PreviewColorMode.Custom && custom != null) ? custom.OutputWhite : 255;
        int brightness = (mode == PreviewColorMode.Custom && custom != null) ? custom.Brightness : 0;
        int contrast = (mode == PreviewColorMode.Custom && custom != null) ? custom.Contrast : 0;
        int saturation = (mode == PreviewColorMode.Custom && custom != null) ? custom.Saturation : 0;
        int whitening = (mode == PreviewColorMode.Custom && custom != null) ? custom.Whitening : 0;
        int threshold = (mode == PreviewColorMode.Custom && custom != null) ? custom.Threshold : 135;
        int blackBoost = (mode == PreviewColorMode.Custom && custom != null) ? custom.BlackBoost : 0;
        int deYellow = (mode == PreviewColorMode.Custom && custom != null) ? custom.DeYellow : 0;
        int colorTemp = (mode == PreviewColorMode.Custom && custom != null) ? custom.ColorTemp : 0;
        int sharpness = (mode == PreviewColorMode.Custom && custom != null) ? custom.Sharpness : 0;
        int descreen = (mode == PreviewColorMode.Custom && custom != null) ? custom.Descreen : 0;
        bool invert = (mode == PreviewColorMode.Custom && custom != null) ? custom.Invert : false;

        // Spline Curves LUTs
        byte[] curveLutRGB = null;
        byte[] curveLutR = null;
        byte[] curveLutG = null;
        byte[] curveLutB = null;
        if (mode == PreviewColorMode.Custom && custom != null) {
            curveLutRGB = BuildCurveLut(CustomColorPreset.ParseCurveString(custom.CurveDataRGB));
            curveLutR = BuildCurveLut(CustomColorPreset.ParseCurveString(custom.CurveDataR));
            curveLutG = BuildCurveLut(CustomColorPreset.ParseCurveString(custom.CurveDataG));
            curveLutB = BuildCurveLut(CustomColorPreset.ParseCurveString(custom.CurveDataB));
        }

        byte[] lut = new byte[256];
        float cFactor = (259f * (contrast + 255f)) / (255f * (259f - contrast));
        float invGamma = 1.0f / Math.Max(0.1f, gamma);
        float inRange = Math.Max(1f, highlights - shadows);
        float outRange = Math.Max(1f, outWhite - outBlack);

        for (int i = 0; i < 256; i++)
        {
            float v = Math.Max(0f, Math.Min(1f, (i - shadows) / inRange));
            v = (float)Math.Pow(v, invGamma);
            float val255 = v * 255f;
            float cVal = cFactor * (val255 - 128f) + 128f + brightness;
            cVal = Math.Max(0f, Math.Min(255f, cVal));
            // Output Level mapping
            float outVal = outBlack + (cVal / 255f) * outRange;
            lut[i] = (byte)Math.Max(0, Math.Min(255, (int)Math.Round(outVal)));
        }

        byte minLum = 255;
        byte maxLum = 0;
        if (autoColor || mode == PreviewColorMode.DocumentColor)
        {
            int stepY = Math.Max(1, h / 120);
            int stepX = Math.Max(1, w / 120);
            for (int y = 0; y < h; y += stepY)
            {
                int rowStart = y * stride;
                for (int x = 0; x < w; x += stepX)
                {
                    int idx = rowStart + (x * 4);
                    byte b = pixels[idx];
                    byte g = pixels[idx + 1];
                    byte r = pixels[idx + 2];
                    byte lum = (byte)((r * 77 + g * 150 + b * 29) >> 8);
                    if (lum < minLum) minLum = lum;
                    if (lum > maxLum) maxLum = lum;
                }
            }
            if (maxLum <= minLum) { minLum = 0; maxLum = 255; }
        }

        for (int y = 0; y < h; y++)
        {
            int rowStart = y * stride;
            for (int x = 0; x < w; x++)
            {
                int idx = rowStart + (x * 4);
                byte b = pixels[idx];
                byte g = pixels[idx + 1];
                byte r = pixels[idx + 2];

                if (autoColor && maxLum > minLum)
                {
                    r = (byte)Math.Max(0, Math.Min(255, (r - minLum) * 255 / (maxLum - minLum)));
                    g = (byte)Math.Max(0, Math.Min(255, (g - minLum) * 255 / (maxLum - minLum)));
                    b = (byte)Math.Max(0, Math.Min(255, (b - minLum) * 255 / (maxLum - minLum)));
                }

                if (mode == PreviewColorMode.Custom && custom != null)
                {
                    // 1. Levels LUT
                    r = lut[r];
                    g = lut[g];
                    b = lut[b];

                    // 2. Spline Curves LUT
                    if (curveLutRGB != null) {
                        r = curveLutRGB[r];
                        g = curveLutRGB[g];
                        b = curveLutRGB[b];
                    }
                    if (curveLutR != null) r = curveLutR[r];
                    if (curveLutG != null) g = curveLutG[g];
                    if (curveLutB != null) b = curveLutB[b];

                    // 3. Text & Ink Darkness Deepening
                    if (blackBoost != 0) {
                        int lum = (r * 77 + g * 150 + b * 29) >> 8;
                        if (blackBoost > 0 && lum < 155) {
                            int darken = (155 - lum) * blackBoost / 100;
                            r = (byte)Math.Max(0, r - darken);
                            g = (byte)Math.Max(0, g - darken);
                            b = (byte)Math.Max(0, b - darken);
                        } else if (blackBoost < 0 && lum < 155) {
                            int lighten = (155 - lum) * (-blackBoost) / 100;
                            r = (byte)Math.Min(255, r + lighten);
                            g = (byte)Math.Min(255, g + lighten);
                            b = (byte)Math.Min(255, b + lighten);
                        }
                    }

                    // 4. Paper White Boost
                    if (whitening > 0) {
                        int lum = (r * 77 + g * 150 + b * 29) >> 8;
                        if (lum > 160) {
                            int boost = (lum - 160) * whitening / 95;
                            r = (byte)Math.Min(255, r + boost);
                            g = (byte)Math.Min(255, g + boost);
                            b = (byte)Math.Min(255, b + boost);
                        }
                    }

                    // 5. Background De-Yellow & Bleed Clean
                    if (deYellow > 0) {
                        int lum = (r * 77 + g * 150 + b * 29) >> 8;
                        if (r > b && g > b && lum > 130) {
                            int yellowDiff = Math.Min(r - b, g - b);
                            int bFix = yellowDiff * deYellow / 100;
                            b = (byte)Math.Min(255, b + bFix);
                        }
                    }

                    // 6. Color Warmth / Temp
                    if (colorTemp != 0) {
                        if (colorTemp > 0) {
                            r = (byte)Math.Min(255, r + colorTemp);
                            b = (byte)Math.Max(0, b - colorTemp);
                        } else {
                            b = (byte)Math.Min(255, b + (-colorTemp));
                            r = (byte)Math.Max(0, r - (-colorTemp));
                        }
                    }

                    // 7. Saturation Boost
                    if (saturation != 0) {
                        int avg = (r + g + b) / 3;
                        float satFactor = 1.0f + (saturation / 100.0f);
                        r = (byte)Math.Max(0, Math.Min(255, (int)(avg + (r - avg) * satFactor)));
                        g = (byte)Math.Max(0, Math.Min(255, (int)(avg + (g - avg) * satFactor)));
                        b = (byte)Math.Max(0, Math.Min(255, (int)(avg + (b - avg) * satFactor)));
                    }

                    // 8. Text Clarity & Sharpness
                    if (sharpness > 0) {
                        int lum = (r * 77 + g * 150 + b * 29) >> 8;
                        if (lum < 110) {
                            int shDark = (110 - lum) * sharpness / 140;
                            r = (byte)Math.Max(0, r - shDark);
                            g = (byte)Math.Max(0, g - shDark);
                            b = (byte)Math.Max(0, b - shDark);
                        } else if (lum > 170) {
                            int shBright = (lum - 170) * sharpness / 140;
                            r = (byte)Math.Min(255, r + shBright);
                            g = (byte)Math.Min(255, g + shBright);
                            b = (byte)Math.Min(255, b + shBright);
                        }
                    }

                    // 9. Invert Colors
                    if (invert) {
                        r = (byte)(255 - r);
                        g = (byte)(255 - g);
                        b = (byte)(255 - b);
                    }

                    // 10. Output Modes
                    if (custom.IsBW) {
                        int lum = (r * 77 + g * 150 + b * 29) >> 8;
                        byte bw = (lum >= threshold) ? (byte)255 : (byte)0;
                        pixels[idx] = bw;
                        pixels[idx + 1] = bw;
                        pixels[idx + 2] = bw;
                        continue;
                    }
                    if (custom.IsGrayscale) {
                        byte gray = (byte)((r * 77 + g * 150 + b * 29) >> 8);
                        pixels[idx] = gray;
                        pixels[idx + 1] = gray;
                        pixels[idx + 2] = gray;
                        continue;
                    }
                    pixels[idx] = b;
                    pixels[idx + 1] = g;
                    pixels[idx + 2] = r;
                    continue;
                }

                switch (mode)
                {
                    case PreviewColorMode.Color24:
                        pixels[idx] = b;
                        pixels[idx + 1] = g;
                        pixels[idx + 2] = r;
                        break;

                    case PreviewColorMode.DocumentColor:
                        int docLum = (r * 77 + g * 150 + b * 29) >> 8;
                        if (docLum > 180) {
                            int boost = (docLum - 180) * 75 / 75;
                            r = (byte)Math.Min(255, r + boost);
                            g = (byte)Math.Min(255, g + boost);
                            b = (byte)Math.Min(255, b + boost);
                        } else if (docLum < 120) {
                            r = (byte)Math.Max(0, r - 25);
                            g = (byte)Math.Max(0, g - 25);
                            b = (byte)Math.Max(0, b - 25);
                        }
                        pixels[idx] = b;
                        pixels[idx + 1] = g;
                        pixels[idx + 2] = r;
                        break;

                    case PreviewColorMode.PhotoVibrant:
                        int avg = (r + g + b) / 3;
                        r = (byte)Math.Max(0, Math.Min(255, r + (int)((r - avg) * 0.4f)));
                        g = (byte)Math.Max(0, Math.Min(255, g + (int)((g - avg) * 0.4f)));
                        b = (byte)Math.Max(0, Math.Min(255, b + (int)((b - avg) * 0.4f)));
                        pixels[idx] = b;
                        pixels[idx + 1] = g;
                        pixels[idx + 2] = r;
                        break;

                    case PreviewColorMode.Grayscale8:
                        byte gray = (byte)((r * 77 + g * 150 + b * 29) >> 8);
                        pixels[idx] = gray;
                        pixels[idx + 1] = gray;
                        pixels[idx + 2] = gray;
                        break;

                    case PreviewColorMode.BlackAndWhite1:
                        int lumVal = (r * 77 + g * 150 + b * 29) >> 8;
                        byte bwVal = (lumVal >= threshold) ? (byte)255 : (byte)0;
                        pixels[idx] = bwVal;
                        pixels[idx + 1] = bwVal;
                        pixels[idx + 2] = bwVal;
                        break;
                }
            }
        }

        Marshal.Copy(pixels, 0, scan0, byteCount);
        working.UnlockBits(data);
        return working;
    }

    // ================= The Modern Live Preview Scanner Studio Dialog =================
    enum DragHandle { None, Body, NW, N, NE, E, SE, S, SW, W, DrawNew }

    static Rectangle GetImageDisplayRect(PictureBox pic)
    {
        if (pic.Image == null) return pic.ClientRectangle;
        float imgAspect = (float)pic.Image.Width / pic.Image.Height;
        float boxAspect = (float)pic.Width / pic.Height;
        if (boxAspect > imgAspect) {
            int h = pic.Height;
            int w = (int)(h * imgAspect);
            int x = (pic.Width - w) / 2;
            return new Rectangle(x, 0, w, h);
        } else {
            int w = pic.Width;
            int h = (int)(w / imgAspect);
            int y = (pic.Height - h) / 2;
            return new Rectangle(0, y, w, h);
        }
    }

    static bool ShowDialog(string naps2)
    {
        bool go = false;

        Form f = new Form();
        f.Text = "Scan to Photoshop";
        f.ClientSize = new Size(980, 620);
        f.StartPosition = FormStartPosition.CenterScreen;
        f.FormBorderStyle = FormBorderStyle.None;
        f.MaximizeBox = false;
        f.MinimizeBox = false;
        f.Font = new Font("Segoe UI", 9.5f);
        f.BackColor = Color.FromArgb(245, 246, 248);
        f.TopMost = false;
        f.KeyPreview = true;

        f.Paint += delegate(object sender, PaintEventArgs e) {
            using (Pen borderPen = new Pen(Color.FromArgb(200, 205, 215), 1.5f)) {
                e.Graphics.DrawRectangle(borderPen, 0, 0, f.Width - 1, f.Height - 1);
            }
        };

        ToolTip tt = new ToolTip();
        tt.AutoPopDelay = 5000;
        tt.InitialDelay = 400;
        tt.ReshowDelay = 100;

        // ================= TOP BAR (0 - 44px) =================
        Panel pTop = new Panel();
        pTop.Location = new Point(0, 0);
        pTop.Size = new Size(980, 44);
        pTop.BackColor = Color.White;
        pTop.Paint += delegate(object sender, PaintEventArgs e) {
            using (Pen bp = new Pen(Color.FromArgb(229, 231, 235), 1f)) {
                e.Graphics.DrawLine(bp, 0, 43, 980, 43);
            }
        };

        MouseEventHandler dragWindow = delegate(object sender, MouseEventArgs e) {
            if (e.Button == MouseButtons.Left) {
                ReleaseCapture();
                SendMessage(f.Handle, WM_NCLBUTTONDOWN, HT_CAPTION, 0);
            }
        };
        pTop.MouseDown += dragWindow;

        Label lTopTitle = new Label();
        lTopTitle.Text = "\uD83D\uDDA8\uFE0F  Scan to Photoshop";
        lTopTitle.Font = new Font("Segoe UI", 11f, FontStyle.Bold);
        lTopTitle.ForeColor = Color.FromArgb(31, 31, 31);
        lTopTitle.Location = new Point(16, 10);
        lTopTitle.Size = new Size(220, 24);
        lTopTitle.MouseDown += dragWindow;

        Label lTopScanner = new Label();
        lTopScanner.Text = "Scanner";
        lTopScanner.ForeColor = Color.FromArgb(110, 110, 110);
        lTopScanner.Location = new Point(450, 12);
        lTopScanner.Size = new Size(56, 20);
        lTopScanner.MouseDown += dragWindow;

        ComboBox cbDev = new ComboBox();
        cbDev.DropDownStyle = ComboBoxStyle.DropDownList;
        cbDev.Location = new Point(510, 9);
        cbDev.Size = new Size(220, 24);
        cbDev.Font = new Font("Segoe UI", 9f);

        Label lReady = new Label();
        lReady.Text = "\u25CF Ready";
        lReady.ForeColor = Color.FromArgb(22, 163, 74);
        lReady.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
        lReady.Location = new Point(740, 12);
        lReady.Size = new Size(85, 20);
        lReady.MouseDown += dragWindow;

        Button bTopHelp = new Button();
        bTopHelp.Text = "?";
        bTopHelp.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
        bTopHelp.ForeColor = Color.FromArgb(100, 100, 100);
        bTopHelp.Location = new Point(885, 8);
        bTopHelp.Size = new Size(28, 26);
        bTopHelp.FlatStyle = FlatStyle.Flat;
        bTopHelp.FlatAppearance.BorderColor = Color.FromArgb(220, 220, 220);
        bTopHelp.Cursor = Cursors.Hand;
        tt.SetToolTip(bTopHelp, "Keyboard Shortcuts:\r\n\u2022 Drag marquee to move or resize\r\n\u2022 Shift+Drag to constrain square\r\n\u2022 Arrow keys to nudge crop\r\n\u2022 Ctrl+A: Full Bed | Ctrl+D: Auto-Detect");
        bTopHelp.Click += delegate {
