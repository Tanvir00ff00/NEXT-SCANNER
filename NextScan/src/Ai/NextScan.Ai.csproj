<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The AI layer, and the only part of this repository that takes dependencies.

    It exists as its own assembly for one reason: everything else here builds
    with csc.exe and no project file, deliberately, and the official provider
    SDKs need NuGet. Keeping them behind one boundary means the shell still
    compiles the way it always did and sees exactly one new reference.

    The language version is not the 7.3 the rest of the code uses. That is not
    drift. The SDKs require init-only setters and async streams, so a 7.3
    project cannot reference them at all. The facade exposes nothing that needs
    a modern language feature, so the shell stays on 7.3.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NextScan.Ai</AssemblyName>
    <RootNamespace>NextScan.Ai</RootNamespace>

    <!-- Three netstandard2.0 packages on .NET Framework need assembly
         redirects. MSBuild writes them; writing fifteen by hand is how a
         build compiles and then fails on somebody else's machine. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      OpenAI ships reasoning effort as an evaluation API: using it is an error
      until the diagnostic is suppressed deliberately. Suppressed here, and
      narrowly, because the thinking level is the point of the panel. If a
      future SDK changes that surface this is where the break will surface.
    -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI. On .NET Framework it lives in System.Security, which an
         SDK-style project does not reference unless told. -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- The providers' own SDKs. Google.GenAI is Google's, not one of the
         several community wrappers with similar names. -->
    <PackageReference Include="Anthropic" Version="12.49.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Google.GenAI" Version="1.21.1" />
  </ItemGroup>

</Project>
